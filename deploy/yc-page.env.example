# JDK 21 的实际安装目录，不要指向 JDK 8。
JAVA_HOME='/usr/local/java/jdk-21'

# 可选 JVM 参数。
JAVA_OPTS='-Xms256m -Xmx512m'

# 微信配置。
YC_WECHAT_TOKEN='replace_me'
YC_WECHAT_ENCODINGAESKEY='replace_me'
YC_WECHAT_MINI_APPID='replace_me'
YC_WECHAT_MINI_APPSECRET='replace_me'

# Redis 配置。
YC_REDIS_HOST='127.0.0.1'
YC_REDIS_PASSWORD=''
YC_REDIS_DATABASE='0'

# MySQL 配置。
YC_MYSQL_HOST='127.0.0.1'
YC_MYSQL_USERNAME='root'
YC_MYSQL_PASSWORD='replace_me'

# 至少 32 个字符。首次可在服务器执行 openssl rand -hex 32 生成。
YC_JWT_SECRET='replace_with_at_least_32_characters'
